#!/bin/sh
# devloop-comment-gates <path>... [--base <ref>] [--terms <file>] [--lang <code>]
#
# Reads the comments of the given files and reports what reads badly in them. It never
# writes anything back.
#
# OUTPUT
#   One finding per line on stdout:   file:line:check:text
#   The rule is a SPLIT rule, not a field count: the first three ":" separate the
#   fields and everything after the third one is the text. A comment carrying a colon
#   of its own ("TODO: review this") therefore arrives whole, while a reader that
#   counts four fields would cut it in half.
#   Notes - a file skipped for an unknown extension, a check that did not run - go to
#   stderr instead, so an empty stdout means "no findings" and nothing else.
#
# CHECKS. The name is the third field and these five are fixed:
#   process-ref   references to the process: a base list plus the terms of --terms.
#   missing-name  names quoted in backticks, or written Class::method(), that the
#                 repository does not carry outside its comments.
#   line-ref      line numbers quoted as file.ext:NN or `:NN`.
#   tense         past and conditional forms, in the language of --lang.
#   lost-fact     with --base only: numbers and names the diff drops from a comment
#                 without putting them back.
#
# DECLARED LIMIT of missing-name. The search is `git grep -F`, which only sees TRACKED
# files: a name that so far lives in a file nobody has added yet reads as missing, and
# a finding on a name you have just written is that false positive. The search also
# throws away a hit whose line looks like a comment, which is a guess of its own - a
# name cited inside a docstring that carries no marker still counts as a real
# occurrence.
#
# DEVIATION from the spec. The line field of lost-fact is `base@NN`, not the `base:NN`
# of section 4.4: `base:NN` would put a fourth ":" before the text and break the split
# rule above.
#
# SCOPE. Without --base, every comment of the given paths. With --base, only the
# comments that change between <ref> and the working tree.
#
# OUTSIDE A GIT REPOSITORY missing-name and lost-fact are skipped and said so on
# stderr; the other three run. --base there is a bad argument (2), not an unresolvable
# ref (3).
#
# EXIT
#   0  complete run, findings or not
#   2  bad arguments, a missing or unreadable --terms file included, and --base
#      outside a repository
#   3  a --base ref that git cannot resolve inside a repository
#
# Comments are recognised by extension and every block counts as one unit: a finding
# inside a multi-line /* */ is reported once, against the line the block opens on.
#
# The language patterns live between the literal markers "# c6-exempt:start" and
# "# c6-exempt:end". tests/checks.sh cuts that region out before it forbids non-English
# prose inside the plugin, so a pattern written anywhere else turns that check red.

set -u

GATES_SELF=devloop-comment-gates

# c6-exempt:start
# Every pattern a check has to spell in a language other than English lives here and
# nowhere else. The tense patterns run against the text lowercased and padded with a
# space at each end, which is why a word is fenced with [^a-z] instead of a word
# boundary: mawk has no \b.
GATES_TENSE_EN='[^a-z](was|were|had|would|could|should|might|previously|formerly)[^a-z]'
GATES_TENSE_IT='[^a-z](era|erano|aveva|avevano|fu|furono|sarebbe|avrebbe|potrebbe|dovrebbe|veniva|venivano|prima|precedenza)[^a-z]'
GATES_PROCESS_REF_IT='decisione [a-z0-9]
dopo la revisione
come deciso'
# c6-exempt:end

# The English half of the base process-ref list. A term is an extended regular
# expression, matched against the lowercased comment.
GATES_PROCESS_REF_EN='batch [0-9]
decision [a-z0-9]
after the review'

gatesNote() {
    printf '%s: %s\n' "$GATES_SELF" "$1" >&2
}

gatesUsage() {
    cat >&2 <<'GATES_USAGE'
usage: devloop-comment-gates <path>... [--base <ref>] [--terms <file>] [--lang <code>]
GATES_USAGE
}

gatesBadArgs() {
    gatesNote "$1"
    gatesUsage
    exit 2
}

GATES_TMP="${TMPDIR:-/tmp}/devloop-comment-gates-$$"
gatesCleanup() {
    rm -rf "$GATES_TMP"
}
trap 'gatesCleanup' EXIT
trap 'gatesCleanup; exit 1' HUP INT TERM
rm -rf "$GATES_TMP"
mkdir -p "$GATES_TMP" || exit 1

# ---------------------------------------------------------------------------
# Arguments
# ---------------------------------------------------------------------------
gates_base=''
gates_has_base=0
gates_terms=''
gates_lang=en
: > "$GATES_TMP/paths"
gates_paths=0

gatesAddPath() {
    printf '%s\n' "$1" >> "$GATES_TMP/paths"
    gates_paths=$((gates_paths + 1))
}

while [ $# -gt 0 ]; do
    case $1 in
        --base)
            shift
            [ $# -ge 1 ] || gatesBadArgs "--base wants a ref"
            gates_base=$1
            gates_has_base=1
            ;;
        --terms)
            shift
            [ $# -ge 1 ] || gatesBadArgs "--terms wants a file"
            gates_terms=$1
            ;;
        --lang)
            shift
            [ $# -ge 1 ] || gatesBadArgs "--lang wants a language code"
            gates_lang=$1
            ;;
        --)
            shift
            while [ $# -gt 0 ]; do
                gatesAddPath "$1"
                shift
            done
            break
            ;;
        -*)
            gatesBadArgs "unknown option: $1"
            ;;
        *)
            gatesAddPath "$1"
            ;;
    esac
    [ $# -gt 0 ] && shift
done

[ "$gates_paths" -gt 0 ] || gatesBadArgs "no path to read"

if [ -n "$gates_terms" ]; then
    if [ ! -f "$gates_terms" ] || [ ! -r "$gates_terms" ]; then
        gatesBadArgs "cannot read the terms file: $gates_terms"
    fi
fi

gates_in_repo=0
gates_top=''
if git rev-parse --git-dir >/dev/null 2>&1; then
    gates_in_repo=1
    gates_top=$(git rev-parse --show-toplevel 2>/dev/null) || gates_top=''
fi

if [ "$gates_has_base" = 1 ]; then
    if [ "$gates_in_repo" = 0 ]; then
        # Not an unresolvable ref: there is no repository to resolve it against.
        gatesBadArgs "--base needs a git repository"
    fi
    if ! git rev-parse --verify --quiet "$gates_base^{commit}" >/dev/null 2>&1; then
        gatesNote "git cannot resolve the --base ref: $gates_base"
        exit 3
    fi
fi

if [ "$gates_in_repo" = 0 ]; then
    gatesNote "not a git repository: the missing-name check was skipped"
    gatesNote "not a git repository: the lost-fact check was skipped"
fi

case $gates_lang in
    en) gates_langpat=$GATES_TENSE_EN ;;
    it) gates_langpat=$GATES_TENSE_IT ;;
    *)
        gates_langpat=''
        gatesNote "no patterns for the language '$gates_lang': the tense check was skipped"
        ;;
esac

{
    printf '%s\n' "$GATES_PROCESS_REF_EN"
    printf '%s\n' "$GATES_PROCESS_REF_IT"
} > "$GATES_TMP/terms"
if [ -n "$gates_terms" ]; then
    cat "$gates_terms" >> "$GATES_TMP/terms" || exit 2
fi

# ---------------------------------------------------------------------------
# The awk half: comment extraction, the checks that read only the comment, the
# facts a base version carried, and the reading of `git grep` output.
# ---------------------------------------------------------------------------
cat > "$GATES_TMP/blocks.awk" <<'GATES_BLOCKS_AWK'
# Prints one record per comment block: "<line the block opens on><TAB><text>".
# The text of a block is its lines joined by a single space, so a block is one unit.
# -v style=<c|php|cblock|hash|python|sql|dash|xml>

function addText(s,   t) {
    t = s
    gsub(/\t/, " ", t)
    if (star == 1 && mode == "block") sub(/^ *\*+ ?/, "", t)
    gsub(/  +/, " ", t)
    sub(/^ +/, "", t)
    sub(/ +$/, "", t)
    if (t == "") return
    if (cur == "") cur = t
    else cur = cur " " t
}

function emit() {
    if (have == 1 && cur != "") {
        if (length(cur) > 240) cur = substr(cur, 1, 237) "..."
        printf "%d\t%s\n", start, cur
    }
    have = 0
    cur = ""
    mode = ""
}

function open(n, kind) {
    emit()
    have = 1
    start = n
    cur = ""
    mode = kind
}

# Position of the first <m> in <s> whose preceding character is not <g>, or 0.
# The guard is what keeps the "//" of a URL from opening a comment.
function findMark(s, m, g,   off, p, pos) {
    if (m == "") return 0
    off = 0
    while (1) {
        p = index(substr(s, off + 1), m)
        if (p == 0) return 0
        pos = off + p
        if (g != "" && pos > 1 && substr(s, pos - 1, 1) == g) {
            off = pos
            continue
        }
        return pos
    }
}

BEGIN {
    lm1 = ""; lm2 = ""; bo = ""; bc = ""; bo2 = ""; bc2 = ""; star = 0; guard = ""
    if (style == "c") {
        lm1 = "//"; guard = ":"; bo = "/*"; bc = "*/"; star = 1
    } else if (style == "php") {
        lm1 = "//"; guard = ":"; lm2 = "#"; bo = "/*"; bc = "*/"; star = 1
    } else if (style == "cblock") {
        bo = "/*"; bc = "*/"; star = 1
    } else if (style == "hash") {
        lm1 = "#"
    } else if (style == "python") {
        lm1 = "#"; bo = "\"\"\""; bc = "\"\"\""; bo2 = "'''"; bc2 = "'''"
    } else if (style == "sql") {
        lm1 = "--"; bo = "/*"; bc = "*/"; star = 1
    } else if (style == "dash") {
        lm1 = "--"
    } else if (style == "xml") {
        bo = "<!--"; bc = "-->"
    }
    have = 0; cur = ""; start = 0; inblk = 0; endmark = ""; mode = ""; lastline = -1
}

{
    line = $0
    sub(/\r$/, "", line)

    if (inblk == 1) {
        p = index(line, endmark)
        if (p > 0) {
            addText(substr(line, 1, p - 1))
            inblk = 0
            emit()
        } else {
            addText(line)
        }
        next
    }

    # A shebang is an instruction to the kernel, not a comment anyone wrote to be read.
    if (NR == 1 && substr(line, 1, 2) == "#!") {
        emit()
        next
    }

    bestpos = 0; bestkind = ""; bestmark = ""
    p = findMark(line, lm1, guard)
    if (p > 0) { bestpos = p; bestkind = "line"; bestmark = lm1 }
    p = findMark(line, lm2, "")
    if (p > 0 && (bestpos == 0 || p < bestpos)) { bestpos = p; bestkind = "line"; bestmark = lm2 }
    p = findMark(line, bo, "")
    if (p > 0 && (bestpos == 0 || p < bestpos)) { bestpos = p; bestkind = "b1"; bestmark = bo }
    p = findMark(line, bo2, "")
    if (p > 0 && (bestpos == 0 || p < bestpos)) { bestpos = p; bestkind = "b2"; bestmark = bo2 }

    if (bestpos == 0) {
        # A line of code, or a blank one, closes whatever run of comments came before.
        emit()
        next
    }

    if (bestkind == "line") {
        content = substr(line, bestpos + length(bestmark))
        if (have == 1 && mode == "line" && lastline == NR - 1) {
            addText(content)
        } else {
            open(NR, "line")
            addText(content)
        }
        lastline = NR
        next
    }

    if (bestkind == "b2") closemark = bc2
    else closemark = bc
    open(NR, "block")
    rest = substr(line, bestpos + length(bestmark))
    q = index(rest, closemark)
    if (q > 0) {
        addText(substr(rest, 1, q - 1))
        emit()
    } else {
        addText(rest)
        inblk = 1
        endmark = closemark
    }
}

END {
    emit()
}
GATES_BLOCKS_AWK

cat > "$GATES_TMP/checks.awk" <<'GATES_CHECKS_AWK'
# Reads the terms file first, then the block records, and prints one record per finding:
#   F <TAB> file <TAB> line <TAB> check <TAB> text        a finding, ready to print
#   N <TAB> file <TAB> line <TAB> name <TAB> text         a name the caller must look up
# -v tf=<terms file> -v file=<path> -v langpat=<tense pattern, empty to skip>

function cleanName(s,   t) {
    t = s
    sub(/^[ \t]+/, "", t)
    sub(/[ \t]+$/, "", t)
    sub(/\(\)$/, "", t)
    if (t !~ "^[A-Za-z_][A-Za-z0-9_.:/-]*$") return ""
    if (length(t) < 2) return ""
    return t
}

function names(text, ln,   m, parts, i, nm, rest, seen) {
    split("", seen)
    m = split(text, parts, "`")
    for (i = 2; i <= m; i += 2) {
        nm = cleanName(parts[i])
        if (nm != "" && !(nm in seen)) {
            seen[nm] = 1
            printf "N\t%s\t%s\t%s\t%s\n", file, ln, nm, text
        }
    }
    rest = text
    while (match(rest, /[A-Za-z_][A-Za-z0-9_]*::[A-Za-z_][A-Za-z0-9_]*(\(\))?/)) {
        nm = cleanName(substr(rest, RSTART, RLENGTH))
        if (nm != "" && !(nm in seen)) {
            seen[nm] = 1
            printf "N\t%s\t%s\t%s\t%s\n", file, ln, nm, text
        }
        rest = substr(rest, RSTART + RLENGTH)
    }
}

FILENAME == tf {
    if ($0 != "") {
        nterms++
        terms[nterms] = tolower($0)
    }
    next
}

{
    ln = $1
    text = $2
    low = " " tolower(text) " "

    for (i = 1; i <= nterms; i++) {
        if (low ~ terms[i]) {
            printf "F\t%s\t%s\tprocess-ref\t%s\n", file, ln, text
            break
        }
    }

    if (text ~ /[A-Za-z0-9_-]+\.[A-Za-z0-9]+:[0-9]+/ || text ~ /`:[0-9]+/) {
        printf "F\t%s\t%s\tline-ref\t%s\n", file, ln, text
    }

    if (langpat != "" && low ~ langpat) {
        printf "F\t%s\t%s\ttense\t%s\n", file, ln, text
    }

    names(text, ln)
}
GATES_CHECKS_AWK

cat > "$GATES_TMP/lostfact.awk" <<'GATES_LOSTFACT_AWK'
# Reads the working-tree block records first, then the base ones, and prints an F record
# per fact the base comment carried and the working tree no longer carries anywhere.
# -v cf=<working-tree records> -v file=<path>

function cleanName(s,   t) {
    t = s
    sub(/^[ \t]+/, "", t)
    sub(/[ \t]+$/, "", t)
    sub(/\(\)$/, "", t)
    if (t !~ "^[A-Za-z_][A-Za-z0-9_.:/-]*$") return ""
    if (length(t) < 2) return ""
    return t
}

# Fills keys[] with the facts of <text> and disp[] with how to print them, in the order
# they appear, and returns how many there are. A fact is a name or a number: the key is
# prefixed so that the name 42 and the number 42 cannot be taken for each other.
function factsOf(text, keys, disp,   n, m, parts, i, nm, rest, t, p, seen) {
    n = 0
    split("", seen)
    m = split(text, parts, "`")
    for (i = 2; i <= m; i += 2) {
        nm = cleanName(parts[i])
        if (nm != "" && !(("@" nm) in seen)) {
            seen["@" nm] = 1; n++; keys[n] = "@" nm; disp[n] = nm
        }
    }
    rest = text
    while (match(rest, /[A-Za-z_][A-Za-z0-9_]*::[A-Za-z_][A-Za-z0-9_]*(\(\))?/)) {
        nm = cleanName(substr(rest, RSTART, RLENGTH))
        if (nm != "" && !(("@" nm) in seen)) {
            seen["@" nm] = 1; n++; keys[n] = "@" nm; disp[n] = nm
        }
        rest = substr(rest, RSTART + RLENGTH)
    }
    t = text
    gsub(/[^0-9]+/, " ", t)
    m = split(t, p, " ")
    for (i = 1; i <= m; i++) {
        if (p[i] == "") continue
        if (("#" p[i]) in seen) continue
        seen["#" p[i]] = 1; n++; keys[n] = "#" p[i]; disp[n] = p[i]
    }
    return n
}

FILENAME == cf {
    k = factsOf($2, kk, dd)
    for (i = 1; i <= k; i++) have[kk[i]] = 1
    next
}

{
    k = factsOf($2, kk, dd)
    for (i = 1; i <= k; i++) {
        if (!(kk[i] in have)) {
            printf "F\t%s\tbase@%s\tlost-fact\tdropped %s from: %s\n", file, $1, dd[i], $2
        }
    }
}
GATES_LOSTFACT_AWK

cat > "$GATES_TMP/outside.awk" <<'GATES_OUTSIDE_AWK'
# Reads `git grep -F -n` output and prints "found" once the name turns up on a line that
# does not look like a comment. What comes before the name decides: a line-comment
# marker, the opening of a block, or the star of a block continuation, and the hit is
# the comment we are already reading rather than the code we are looking for.
# -v name=<the name>

{
    line = $0
    if (match(line, /^[^:]*:[0-9]+:/)) content = substr(line, RSTART + RLENGTH)
    else content = line
    idx = index(content, name)
    if (idx == 0) next
    prefix = substr(content, 1, idx - 1)
    if (index(prefix, "//") > 0) next
    if (index(prefix, "#") > 0) next
    if (index(prefix, "--") > 0) next
    if (index(prefix, "/*") > 0) next
    if (index(prefix, "<!--") > 0) next
    if (prefix ~ /^[ \t]*\*/) next
    print "found"
    exit
}
GATES_OUTSIDE_AWK

# ---------------------------------------------------------------------------
# The shell half: which files to read, with which comment syntax, and the lookup
# that missing-name needs.
# ---------------------------------------------------------------------------

# Comment syntax by extension. An extension that is not here makes the file unreadable
# to this tool, which says so instead of guessing.
gatesStyleFor() {
    case $1 in
        *.c|*.h|*.cc|*.cpp|*.cxx|*.hh|*.hpp|*.hxx|*.java|*.js|*.jsx|*.mjs|*.cjs|*.ts|*.tsx|*.go|*.rs|*.cs|*.swift|*.kt|*.kts|*.scala|*.m|*.mm|*.dart|*.groovy|*.gradle|*.scss|*.less)
            echo c ;;
        *.php)
            echo php ;;
        *.css)
            echo cblock ;;
        *.sh|*.bash|*.zsh|*.ksh|*.rb|*.pl|*.pm|*.yml|*.yaml|*.toml|*.tf|*.tfvars|*.cfg|*.conf|*.ini|*.mk|*.ps1)
            echo hash ;;
        *.py|*.pyi)
            echo python ;;
        *.sql)
            echo sql ;;
        *.lua|*.hs|*.elm|*.adb|*.ads)
            echo dash ;;
        *.html|*.htm|*.xhtml|*.xml|*.xsl|*.xslt|*.svg|*.vue|*.md|*.markdown)
            echo xml ;;
        *)
            echo '' ;;
    esac
}

# True when the name turns up in a tracked file outside a comment.
gatesNameExists() {
    if [ -n "$gates_top" ]; then
        gates_hit=$(git -C "$gates_top" grep -F -n -e "$1" 2>/dev/null | awk -v name="$1" -f "$GATES_TMP/outside.awk")
    else
        gates_hit=$(git grep -F -n -e "$1" 2>/dev/null | awk -v name="$1" -f "$GATES_TMP/outside.awk")
    fi
    [ -n "$gates_hit" ]
}

# The paths to read, one per line: a directory becomes the tracked files under it,
# which is the only listing available without leaving the closed list of tools.
: > "$GATES_TMP/files"
: > "$GATES_TMP/skipped"
while IFS= read -r gates_path; do
    [ -n "$gates_path" ] || continue
    if [ -d "$gates_path" ]; then
        if [ "$gates_in_repo" = 1 ]; then
            git ls-files -- "$gates_path" >> "$GATES_TMP/files"
        else
            gatesNote "a directory needs a git repository to be listed, skipped: $gates_path"
        fi
        continue
    fi
    if [ ! -f "$gates_path" ] || [ ! -r "$gates_path" ]; then
        gatesBadArgs "cannot read: $gates_path"
    fi
    printf '%s\n' "$gates_path" >> "$GATES_TMP/files"
done < "$GATES_TMP/paths"

while IFS= read -r gates_file; do
    [ -n "$gates_file" ] || continue
    gates_style=$(gatesStyleFor "$gates_file")
    if [ -z "$gates_style" ]; then
        printf '%s\n' "$gates_file" >> "$GATES_TMP/skipped"
        continue
    fi
    [ -f "$gates_file" ] || continue

    # awk reads an argument that starts with a dash as one of its own options, so a file
    # called -odd.js comes back as "not an option" with exit 0 and no findings: a clean
    # bill of health for a file that was never opened. A relative path gets ./ in front;
    # an absolute one already cannot be mistaken for an option.
    case "$gates_file" in
        /*) gates_file_arg=$gates_file ;;
        *)  gates_file_arg="./$gates_file" ;;
    esac
    awk -v style="$gates_style" -f "$GATES_TMP/blocks.awk" "$gates_file_arg" > "$GATES_TMP/cur"

    if [ "$gates_has_base" = 1 ]; then
        if git show "$gates_base:./$gates_file" > "$GATES_TMP/basecontent" 2>/dev/null; then
            awk -v style="$gates_style" -f "$GATES_TMP/blocks.awk" "$GATES_TMP/basecontent" > "$GATES_TMP/base"
        else
            # The file is new in the working tree: every comment in it is a change.
            : > "$GATES_TMP/base"
        fi
        awk -F'\t' -v bf="$GATES_TMP/base" '
            FILENAME == bf { seen[$2] = 1; next }
            !($2 in seen) { print }
        ' "$GATES_TMP/base" "$GATES_TMP/cur" > "$GATES_TMP/scope"
    else
        cp "$GATES_TMP/cur" "$GATES_TMP/scope"
    fi

    : > "$GATES_TMP/raw"
    awk -F'\t' -v tf="$GATES_TMP/terms" -v file="$gates_file" -v langpat="$gates_langpat" \
        -f "$GATES_TMP/checks.awk" "$GATES_TMP/terms" "$GATES_TMP/scope" >> "$GATES_TMP/raw"
    if [ "$gates_has_base" = 1 ]; then
        awk -F'\t' -v cf="$GATES_TMP/cur" -v file="$gates_file" \
            -f "$GATES_TMP/lostfact.awk" "$GATES_TMP/cur" "$GATES_TMP/base" >> "$GATES_TMP/raw"
    fi

    while IFS='	' read -r gates_kind gates_rfile gates_rline gates_rname gates_rtext; do
        [ -n "$gates_kind" ] || continue
        if [ "$gates_kind" = "F" ]; then
            printf '%s:%s:%s:%s\n' "$gates_rfile" "$gates_rline" "$gates_rname" "$gates_rtext"
        elif [ "$gates_kind" = "N" ] && [ "$gates_in_repo" = 1 ]; then
            if ! gatesNameExists "$gates_rname"; then
                printf '%s:%s:missing-name:%s\n' "$gates_rfile" "$gates_rline" "$gates_rtext"
            fi
        fi
    done < "$GATES_TMP/raw"
done < "$GATES_TMP/files"

if [ -s "$GATES_TMP/skipped" ]; then
    gatesNote "skipped, unknown extension:"
    while IFS= read -r gates_skipped_file; do
        gatesNote "  $gates_skipped_file"
    done < "$GATES_TMP/skipped"
fi

exit 0
