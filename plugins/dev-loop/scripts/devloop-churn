#!/bin/sh
# devloop-churn <zone> [--since <date>] [--top <n>]
#
# Prints the files touched most often inside a zone, one per line, as
# `count<TAB>path`, newest window first. It is the evidence design-revision asks for
# before it calls something a change preventer: a file nobody edits does not hurt,
# however ugly it looks.
#
# Invoked by path, never from PATH:
#
#     sh ${CLAUDE_PLUGIN_ROOT}/scripts/devloop-churn src/payments --top 10
#
# <zone> is a GIT PATHSPEC, handed to `git log -- <zone>` unchanged: a directory
# (`src/payments`) or a glob (`src/**/*.php`). Quote it, or the shell expands it
# before git ever sees it. The spec leaves the shape of <zone> open; it is fixed
# here, and batch 07 passes zones in this form.
#
# Output
#   count<TAB>path, sorted by count descending. Files that tie on count come out in
#   byte order of path, so two runs on the same repository print the same thing.
#   A path whose file is gone from the working tree ends with ` (deleted)`.
#   Defaults: the last 12 months, the first 20 files.
#   Warnings go to stderr, never mixed into the list.
#
# Renames are not followed (`--no-renames`): rename detection is a repository
# setting, and a count that changes with the reader's git config is not evidence.
#
# The `--since` wart, declared
#   git's approxidate reads a date it cannot parse as "now", which would quietly
#   return an empty list - and an empty list reads as "nothing changed here". So the
#   date is validated first: `git rev-parse --since=<date>` prints `--max-age=<epoch>`,
#   and a string git could not read lands on the current instant. A date that
#   resolves to within a second of `now` is therefore rejected as unreadable. The
#   cost is that a literal `--since now` (and `--since "1 second ago"`) cannot be
#   asked for. Nobody wants a window of zero seconds, so the trade is worth it.
#
# Exit codes
#   0  done
#   2  bad arguments: no zone, --top not a positive number, unknown option,
#      or a --since date git cannot read
#   3  outside a git repository

set -u

CHURN_USAGE='usage: devloop-churn <zone> [--since <date>] [--top <n>]'

# Complains on stderr and leaves with the given code. POSIX shell gives a function no
# private variables at all, hence the prefix on every name in this file.
churn_die() {
    echo "devloop-churn: $1" >&2
    exit "$2"
}

churn_usage_die() {
    echo "devloop-churn: $1" >&2
    echo "$CHURN_USAGE" >&2
    exit 2
}

# True when git can read the date, false when approxidate silently fell back to now.
churn_date_is_readable() {
    churn_now_raw=$(git rev-parse --since=now 2>/dev/null)
    churn_given_raw=$(git rev-parse --since="$1" 2>/dev/null)
    case $churn_given_raw in
        --max-age=*) ;;
        *) return 1 ;;
    esac
    case $churn_now_raw in
        --max-age=*) ;;
        # No reference instant to compare against: take the date at its word rather
        # than reject something that may well be fine.
        *) return 0 ;;
    esac
    churn_now_epoch=${churn_now_raw#--max-age=}
    churn_given_epoch=${churn_given_raw#--max-age=}
    churn_gap=$((churn_given_epoch - churn_now_epoch))
    if [ "$churn_gap" -lt 0 ]; then
        churn_gap=$((0 - churn_gap))
    fi
    # One second of slack: the two calls straddle a clock tick often enough.
    [ "$churn_gap" -gt 1 ]
}

churn_zone=''
churn_zone_given=0
churn_since=''
churn_top=20

while [ $# -gt 0 ]; do
    case $1 in
        --since)
            [ $# -ge 2 ] || churn_usage_die '--since needs a date'
            churn_since=$2
            shift 2
            ;;
        --since=*)
            churn_since=${1#--since=}
            shift
            ;;
        --top)
            [ $# -ge 2 ] || churn_usage_die '--top needs a number'
            churn_top=$2
            shift 2
            ;;
        --top=*)
            churn_top=${1#--top=}
            shift
            ;;
        -*)
            churn_usage_die "unknown option: $1"
            ;;
        *)
            [ "$churn_zone_given" -eq 0 ] || churn_usage_die "only one zone is accepted, got also: $1"
            churn_zone=$1
            churn_zone_given=1
            shift
            ;;
    esac
done

[ -n "$churn_zone" ] || churn_usage_die 'no zone given'

case $churn_top in
    ''|*[!0-9]*) churn_usage_die "--top wants a positive whole number, got: $churn_top" ;;
esac
[ "$churn_top" -gt 0 ] || churn_usage_die "--top wants a positive whole number, got: $churn_top"

churn_root=$(git rev-parse --show-toplevel 2>/dev/null) || churn_die 'not inside a git repository' 3
[ -n "$churn_root" ] || churn_die 'not inside a git repository' 3

churn_window='12 months ago'
if [ -n "$churn_since" ]; then
    churn_date_is_readable "$churn_since" || churn_usage_die "git cannot read this date: $churn_since"
    churn_window=$churn_since
fi

if [ "$(git rev-parse --is-shallow-repository 2>/dev/null)" = 'true' ]; then
    echo 'devloop-churn: shallow clone, history is truncated: the counts below are floors, not totals' >&2
fi

# A repository whose branch has no commit yet has nothing to count, and git log would
# only complain about it.
git rev-parse --verify --quiet HEAD >/dev/null 2>&1 || exit 0

CHURN_TAB=$(printf '\t')

# core.quotepath off, or a path outside ASCII comes back escaped and unusable.
git -c core.quotepath=false log --no-renames --format='' --name-only \
    --since="$churn_window" -- "$churn_zone" \
    | awk '$0 != "" { churn_count[$0]++ } END { for (churn_path in churn_count) printf "%d\t%s\n", churn_count[churn_path], churn_path }' \
    | LC_ALL=C sort -t "$CHURN_TAB" -k1,1nr -k2,2 \
    | head -n "$churn_top" \
    | while IFS="$CHURN_TAB" read -r churn_line_count churn_line_path; do
        if [ -e "$churn_root/$churn_line_path" ]; then
            printf '%s\t%s\n' "$churn_line_count" "$churn_line_path"
        else
            printf '%s\t%s (deleted)\n' "$churn_line_count" "$churn_line_path"
        fi
    done

exit 0
